# ---- 依赖 ----
node_modules
.pnpm-store

# ---- 构建产物 ----
dist
dist-ssr
.vite

# ---- 构建时生成的博客页面与站点地图（由 scripts/build-posts.mjs 生成，源是 posts/*.md） ----
public/blog/
public/sitemap.xml

# ---- 部署工具 ----
.wrangler
.dev.vars

# ---- WorkBuddy 本地记忆/技能（不属于站点源码） ----
.workbuddy/

# ---- 环境变量 ----
.env
.env.local
.env.*.local

# ---- 编辑器 / 系统 ----
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs

# ---- 临时文件 ----
*.local
*.tmp
temp
